# Copy this file to .env on the RK3588.  Never commit the real .env.
MOWER_IMAGE=mower-rk3588:humble-rtk
MOWER_CONTAINER_NAME=mower-rkt

# Docker Hub is not reachable from the current target network. Override this
# with ros:humble-ros-base-jammy when the official registry is available.
ROS_BASE_IMAGE=docker.m.daocloud.io/library/ros:humble-ros-base-jammy

RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0

# Prefer a stable /dev/serial/by-id path over /dev/ttyUSB0.
UM982_HOST_DEVICE=/dev/serial/by-id/REPLACE_WITH_UM982_DEVICE
UM982_CONTAINER_DEVICE=/dev/um982
UM982_BAUD=115200
UM982_FRAME_ID=rtk_link

CORS_HOST=114.111.30.20
CORS_PORT=8002
CORS_MOUNTPOINT=RTCM33GRCEJ
CORS_GGA_INTERVAL=10.0
CORS_DATA_TIMEOUT=15.0
# Set CORS_USER/CORS_PASS in the shell or a private chmod 600 .env file.
CORS_USER=
CORS_PASS=

HTTP_PORT=8080
ROSBRIDGE_PORT=9090
