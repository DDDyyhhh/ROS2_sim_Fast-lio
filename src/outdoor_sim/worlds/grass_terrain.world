<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="outdoor_flat_features_world">

    <!-- 0. 物理引擎配置：降频至 200Hz，降低 RK3588 CPU 负荷 -->
    <physics name="fast_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 1. Ignition 核心基础物理与控制系统 -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- 2. 独立加载 IMU 系统 -->
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <!-- 3. 加载传感器渲染系统，指定兼容 ARM64 的 ogre 引擎 -->
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- ========================================================== -->
    <!-- 纯本地硬编码的太阳（室内照明）                                  -->
    <!-- ========================================================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ========================================================== -->
    <!-- 地面 (10m×10m 房间底板)                                      -->
    <!-- ========================================================== -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 0.15</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================== -->
    <!-- 四面围墙 (10m × 10m × 2.5m 封闭房间)                          -->
    <!-- ========================================================== -->

    <!-- 北墙 (y = +5.0) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 南墙 (y = -5.0) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 东墙 (x = +5.0) -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 西墙 (x = -5.0) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================== -->
    <!-- 天花顶板 (封闭房间顶部)                                       -->
    <!-- ========================================================== -->
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.575 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 0.15</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================== -->
    <!-- 室内障碍物：3 个错落有致的长方体柱子                           -->
    <!-- ========================================================== -->

    <!-- 柱子 1: 宽矮粗柱 (左后方) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-2.5 -2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.3 0.3 1</ambient>
            <diffuse>0.8 0.3 0.3 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 柱子 2: 窄高方柱 (右前方) -->
    <model name="pillar_2">
      <static>true</static>
      <pose>2.0 1.5 1.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.8 1</ambient>
            <diffuse>0.3 0.5 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 柱子 3: 扁长板柱 (中央偏右) -->
    <model name="pillar_3">
      <static>true</static>
      <pose>0.5 3.0 1.25 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.3 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.3 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.8 0.4 1</ambient>
            <diffuse>0.3 0.8 0.4 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
