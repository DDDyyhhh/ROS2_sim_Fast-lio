<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="outdoor_grassland_50x50">

    <!-- 物理引擎 -->
    <physics name="fast_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ignition 核心系统 -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- 太阳光（室外自然光照） -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>500</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- 环境光补偿（室外阴影区域不要太黑） -->
    <scene>
      <ambient>0.4 0.4 0.5 1</ambient>
      <background>0.8 0.85 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ============================================================ -->
    <!-- 草地地面 (50m × 50m)                                          -->
    <!-- ============================================================ -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50 50 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>50 50 0.1</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.15 1</ambient>   <!-- 草绿色 -->
            <diffuse>0.3 0.55 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 边界标识：低矮围栏/路沿 (非碰撞，纯视觉标记)                     -->
    <!-- 沿 x=-25, x=25, y=-25, y=25 放置                             -->
    <!-- ============================================================ -->
    <model name="boundary_north">
      <static>true</static>
      <pose>0 25.2 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>50.4 0.1 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_south">
      <static>true</static>
      <pose>0 -25.2 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>50.4 0.1 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_east">
      <static>true</static>
      <pose>25.2 0 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 50.4 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_west">
      <static>true</static>
      <pose>-25.2 0 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 50.4 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 固定障碍物：树 × 5（圆柱体模拟）                                 -->
    <!-- ============================================================ -->

    <!-- 树1：左区域 -->
    <model name="tree_1">
      <static>true</static>
      <pose>-15 -10 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.2 0.5 0.1 1</ambient><diffuse>0.25 0.55 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 树2：右区域 -->
    <model name="tree_2">
      <static>true</static>
      <pose>18 8 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
          <material><ambient>0.15 0.45 0.1 1</ambient><diffuse>0.2 0.5 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 树3：左上 -->
    <model name="tree_3">
      <static>true</static>
      <pose>-5 18 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_vis">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><sphere><radius>1.2</radius></sphere></geometry>
          <material><ambient>0.2 0.5 0.1 1</ambient><diffuse>0.25 0.55 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 树4：右下 -->
    <model name="tree_4">
      <static>true</static>
      <pose>10 -15 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_vis">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.15 0.45 0.1 1</ambient><diffuse>0.2 0.5 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 树5：中间偏右 -->
    <model name="tree_5">
      <static>true</static>
      <pose>5 5 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_vis">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
          <material><ambient>0.2 0.5 0.1 1</ambient><diffuse>0.25 0.55 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 固定障碍物：花坛（矩形矮盒）                                    -->
    <!-- ============================================================ -->
    <model name="flowerbed_1">
      <static>true</static>
      <pose>-18 15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.5 0.4</size></box></geometry>
          <material>
            <ambient>0.6 0.2 0.6 1</ambient>
            <diffuse>0.7 0.25 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="flowerbed_2">
      <static>true</static>
      <pose>15 -18 0.2 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.0 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.9 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 固定障碍物：石头（矮球体）                                      -->
    <!-- ============================================================ -->
    <model name="rock_1">
      <static>true</static>
      <pose>-10 20 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>22 -8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>0 -22 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 固定障碍物：喷灌头（小圆柱）                                    -->
    <!-- ============================================================ -->
    <model name="sprinkler_1">
      <static>true</static>
      <pose>8 -8 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.25 0.65 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sprinkler_2">
      <static>true</static>
      <pose>-8 12 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.25 0.65 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sprinkler_3">
      <static>true</static>
      <pose>20 -20 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.25 0.65 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
